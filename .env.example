# Environment Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Binance API Configuration (Get keys from https://www.binance.com/en/account/api-management)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
TESTNET=true

# Logging Configuration
LOG_MAX_SIZE=50m
LOG_MAX_FILES=7
